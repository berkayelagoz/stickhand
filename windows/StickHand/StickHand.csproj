<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\appicon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>StickHand</AssemblyName>
    <RootNamespace>StickHand</RootNamespace>
    <!-- One version for both apps: the repository VERSION file is the release tag, so the
         Windows package and the macOS DMG always ship the same number. FileVersion and
         ProductVersion are derived from Version by the SDK, so a release build that passes
         -p:Version=<tag> keeps every version field in step. -->
    <StickHandVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</StickHandVersion>
    <Version>$(StickHandVersion)</Version>
    <Product>StickHand</Product>
    <AssemblyTitle>StickHand</AssemblyTitle>
    <Company>Kamran Ahmed</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StickHand.Interop\StickHand.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Shared assets live at the repository root (the macOS app bundles the same files):
       the 36 built-in hand sprites (hand + stem compose) and the 15 tap sounds. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\hand_*.png" LogicalName="StickHand.assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\sounds\tap_*.wav" LogicalName="StickHand.assets.sounds.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
