<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\appicon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>StickHand</AssemblyName>
    <RootNamespace>StickHand</RootNamespace>
    <!-- The repository VERSION file is the release tag, so the package version and the
         tag always agree. FileVersion and ProductVersion are derived from Version by the
         SDK, so a release build that passes -p:Version=<tag> keeps every version field in
         step. -->
    <StickHandVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</StickHandVersion>
    <Version>$(StickHandVersion)</Version>
    <Product>StickHand</Product>
    <AssemblyTitle>StickHand</AssemblyTitle>
    <Company>Berkay Elagöz</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StickHand.Interop\StickHand.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Assets live at the repository root: the 36 built-in hand sprites (hand + stem
       compose) and the 15 tap sounds. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\hand_*.png" LogicalName="StickHand.assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\sounds\tap_*.wav" LogicalName="StickHand.assets.sounds.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
